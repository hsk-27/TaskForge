# TaskForge Environment Configuration Example
# Copy to .env for local Docker Compose overrides

# Database
DB_NAME=taskforge
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Backend Port
SERVER_PORT=8080

# Frontend Port
FRONTEND_PORT=3000

# Concurrency Defaults
TASKFORGE_ENGINE_WORKER_COUNT=4
TASKFORGE_ENGINE_QUEUE_CAPACITY=100
TASKFORGE_ENGINE_MAX_ATTEMPTS=3
TASKFORGE_ENGINE_BASE_BACKOFF_MS=1000
